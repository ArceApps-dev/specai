{
  "version": 1,
  "policy": {
    "maxRuntimeSeconds": 900,
    "pollIntervalSeconds": 15,
    "heartbeatIntervalSeconds": 30
  },
  "forbid_inline": true,
  "observableStates": [
    "TASK_BLOCKED",
    "POLLING",
    "DEADLINE_EXCEEDED",
    "PARTIAL"
  ],
  "lifecycle": {
    "timed_out": {
      "state": "POLLING",
      "terminal": false,
      "retain_handle": true
    },
    "deadline": {
      "state": "DEADLINE_EXCEEDED",
      "terminal": true,
      "at_seconds": 900
    },
    "missing_capability": {
      "state": "TASK_BLOCKED",
      "handoff": false,
      "inline_fallback": false
    }
  },
  "requiredCapabilities": [
    "fresh_session",
    "isolated_context",
    "terminal_state"
  ],
  "harnesses": {
    "opencode": {
      "dispatch": "delegate",
      "capabilities": [
        "fresh_session",
        "isolated_context",
        "terminal_state"
      ]
    },
    "codex": {
      "dispatch": "spawn_agent",
      "poll": "wait_agent",
      "close": "close_agent",
      "capabilities": [
        "multi_agent",
        "fresh_session",
        "isolated_context",
        "terminal_state"
      ]
    },
    "antigravity": {
      "dispatch": "invoke_subagent",
      "agentDirectory": ".antigravity-plugin/agents",
      "capabilities": [
        "fresh_session",
        "isolated_context",
        "terminal_state"
      ]
    }
  }
}
