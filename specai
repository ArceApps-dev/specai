}

unlink_opencode() {
    uninstall_opencode "$@"
}

# Link/unlink Hermes
link_hermes() {
    install_hermes "$@"
}

unlink_hermes() {
    uninstall_hermes "$@"
}

# Configure ~/.codex/config.toml with specai marketplace and plugin
link_codex() {
    echo -e "${BLUE}Enlazando specai en Codex...${NC}"
    local codex_dir="${CODEX_CONFIG_DIR:-${HOME}/.codex}"
    local codex_config="${codex_dir}/config.toml"
    mkdir -p "${codex_dir}"

    python3 - "${codex_config}" "${REPO_ROOT}" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
repo_root = str(Path(sys.argv[2]).resolve())

pattern_mkt = re.compile(r'^\s*\[\s*marketplaces\.specai\s*\]', re.IGNORECASE)
pattern_plg = re.compile(r'^\s*\[\s*plugins\.(?:"specai@specai"|\'specai@specai\'|specai@specai)\s*\]', re.IGNORECASE)

def remove_section(content: str, pattern: re.Pattern) -> str:
    lines = content.splitlines(keepends=True)
    new_lines = []
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i]
        if pattern.match(line):
            i += 1
            while i < n:
                if re.match(r'^\s*\[', lines[i]):
                    break
                i += 1
            continue
        new_lines.append(line)
        i += 1
    result = "".join(new_lines)
    result = re.sub(r'\n{3,}', '\n\n', result)
    return result

content = ""
if config_path.is_file():
    try:
        content = config_path.read_text(encoding="utf-8")
    except OSError:
        content = ""

content = remove_section(content, pattern_mkt)
content = remove_section(content, pattern_plg)
content = content.rstrip()

new_sections = f'''[marketplaces.specai]
source_type = "local"
source = {json.dumps(repo_root)}

[plugins."specai@specai"]
enabled = true'''

if content:
    final_content = content + "\n\n" + new_sections + "\n"
else:
    final_content = new_sections + "\n"

config_path.parent.mkdir(parents=True, exist_ok=True)
config_path.write_text(final_content, encoding="utf-8")
PY
    echo -e "${GREEN}✓ Marketplace y plugin de specai configurados en ${codex_config}${NC}"
}

# Remove specai marketplace and plugin from ~/.codex/config.toml
unlink_codex() {
    echo -e "${BLUE}Desvinculando specai de Codex...${NC}"
    local codex_dir="${CODEX_CONFIG_DIR:-${HOME}/.codex}"
    local codex_config="${codex_dir}/config.toml"

    if [ ! -f "${codex_config}" ]; then
        echo -e "${YELLOW}  ${codex_config} no existe — nada que desvincular.${NC}"
        return 0
    fi

    python3 - "${codex_config}" <<'PY'
import os
import re
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
if not config_path.is_file():
    sys.exit(0)

pattern_mkt = re.compile(r'^\s*\[\s*marketplaces\.specai\s*\]', re.IGNORECASE)
pattern_plg = re.compile(r'^\s*\[\s*plugins\.(?:"specai@specai"|\'specai@specai\'|specai@specai)\s*\]', re.IGNORECASE)

def remove_section(content: str, pattern: re.Pattern) -> str:
    lines = content.splitlines(keepends=True)
    new_lines = []
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i]
        if pattern.match(line):
            i += 1
            while i < n:
                if re.match(r'^\s*\[', lines[i]):
                    break
                i += 1
            continue
        new_lines.append(line)
        i += 1
    result = "".join(new_lines)
    result = re.sub(r'\n{3,}', '\n\n', result)
    return result

try:
    content = config_path.read_text(encoding="utf-8")
except OSError:
    sys.exit(0)

new_content = remove_section(content, pattern_mkt)
new_content = remove_section(new_content, pattern_plg)
new_content = new_content.strip()
if new_content:
    new_content += "\n"

config_path.write_text(new_content, encoding="utf-8")
PY
    echo -e "${GREEN}✓ SpecAI desvinculado de ${codex_config}${NC}"
}

