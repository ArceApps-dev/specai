        echo -e "${RED}Error: el directorio de skills ${REPO_SKILLS_DIR} no existe.${NC}"
        exit 1
    fi

    local universal_skills_dir="${UNIVERSAL_SKILLS_DIR:-${HOME}/.agents/skills}"
    mkdir -p "${universal_skills_dir}"

    local linked=0
    shopt -s nullglob
    for skill_dir in "${REPO_SKILLS_DIR}"/*/; do
        local name
        name="$(basename "${skill_dir}")"
