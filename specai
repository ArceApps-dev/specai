# Detect available harnesses in the environment
detect_harnesses() {
    local detected=()
    if [ -d "${HOME}/.gemini/config" ] || command -v agy &>/dev/null; then
        detected+=("antigravity")
    fi
    if [ -d "${HOME}/.codex" ] || command -v codex &>/dev/null; then
        detected+=("codex")
    fi
    if [ -d "${HOME}/.config/opencode" ] || command -v opencode &>/dev/null; then
        detected+=("opencode")
    fi
    if [ -d "${HERMES_HOME:-${HOME}/.hermes}" ]; then
        detected+=("hermes")
    fi
    if [ -d "${HOME}/.agents" ] || command -v dsh &>/dev/null; then
        detected+=("universal")
    fi
    echo "${detected[*]}"
}

# Link specai to detected harnesses
cmd_link() {
    local harnesses
    harnesses=$(detect_harnesses)
    echo -e "${BLUE}Enlazando SpecAI en harnesses detectados: ${harnesses:-ninguno}${NC}"
    if [ -z "$harnesses" ]; then
        echo -e "${YELLOW}No se detectaron harnesses soportados en el sistema.${NC}"
        return 0
    fi
    for h in $harnesses; do
        case "$h" in
            antigravity)
                link_antigravity "$@"
                ;;
            codex)
                link_codex "$@"
                ;;
            opencode)
                link_opencode "$@"
                ;;
            hermes)
                link_hermes "$@"
                ;;
            universal)
                link_universal "$@"
                ;;
            *)
                echo -e "  ${CYAN}Harness detectado:${NC} $h"
                ;;
        esac
    done
}

# Unlink specai from detected harnesses
cmd_unlink() {
    local harnesses
    harnesses=$(detect_harnesses)
    echo -e "${BLUE}Desvinculando SpecAI de harnesses detectados: ${harnesses:-ninguno}${NC}"
    if [ -z "$harnesses" ]; then
        echo -e "${YELLOW}No se detectaron harnesses soportados en el sistema.${NC}"
        return 0
    fi
    for h in $harnesses; do
        case "$h" in
            antigravity)
                unlink_antigravity "$@"
                ;;
            codex)
                unlink_codex "$@"
                ;;
            opencode)
                unlink_opencode "$@"
                ;;
            hermes)
                unlink_hermes "$@"
                ;;
            universal)
                unlink_universal "$@"
                ;;
            *)
                echo -e "  ${CYAN}Harness desvinculado:${NC} $h"
                ;;
        esac
    done
}

# Install SpecAI in detected harnesses
cmd_install() {
    local harnesses
    harnesses=$(detect_harnesses)
    echo -e "${BLUE}Instalando SpecAI en harnesses detectados: ${harnesses:-ninguno}${NC}"
    if [ -z "$harnesses" ]; then
        echo -e "${YELLOW}No se detectaron harnesses soportados en el sistema.${NC}"
        echo "PASS: install configured all detected harnesses (0 detected)"
        return 0
    fi
    for h in $harnesses; do
        case "$h" in
            antigravity)
                link_antigravity "$@"
                ;;
            codex)
                link_codex "$@"
                ;;
            opencode)
                link_opencode "$@"
                ;;
            hermes)
                link_hermes "$@"
                ;;
            universal)
                link_universal "$@"
                ;;
            *)
                echo -e "  ${CYAN}Harness instalado:${NC} $h"
                ;;
        esac
    done
    echo -e "\n${GREEN}${BOLD}Instalación completada en harnesses: ${harnesses}${NC}"
    echo "PASS: install configured all detected harnesses"
}

# Update SpecAI and refresh all detected harnesses
cmd_update() {
    local no_pull=0
    local filtered_args=()
    for arg in "$@"; do
        if [[ "$arg" == "--no-pull" ]]; then
            no_pull=1
        else
            filtered_args+=("$arg")
        fi
    done

    echo -e "${BLUE}Actualizando SpecAI...${NC}"

    if [[ "$no_pull" -eq 0 ]] && command -v git &>/dev/null && git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree &>/dev/null; then
        local remote_origin
        remote_origin=$(git -C "${REPO_ROOT}" config --get remote.origin.url 2>/dev/null || true)
        if [[ -n "$remote_origin" ]]; then
            echo -e "${CYAN}Descargando actualizaciones desde origen remoto (${remote_origin})...${NC}"
            git -C "${REPO_ROOT}" pull --ff-only 2>/dev/null || git -C "${REPO_ROOT}" pull 2>/dev/null || echo -e "${YELLOW}Advertencia: no se pudo actualizar vía git pull.${NC}"
        fi
    fi

    # Sync canonical skills projection if script is present
    if [ -f "${REPO_ROOT}/scripts/sync-antigravity-plugin.sh" ]; then
        bash "${REPO_ROOT}/scripts/sync-antigravity-plugin.sh" 2>/dev/null || true
    fi

    local harnesses
    harnesses=$(detect_harnesses)
    echo -e "${BLUE}Refrescando proyecciones y subagentes en harnesses: ${harnesses:-ninguno}${NC}"

    if [ -n "$harnesses" ]; then
        for h in $harnesses; do
            case "$h" in
                antigravity)
                    link_antigravity "${filtered_args[@]}"
                    ;;
                codex)
                    link_codex "${filtered_args[@]}"
                    ;;
                opencode)
                    link_opencode "${filtered_args[@]}"
                    ;;
                hermes)
                    link_hermes "${filtered_args[@]}"
                    ;;
                universal)
                    link_universal "${filtered_args[@]}"
                    ;;
                *)
                    echo -e "  ${CYAN}Harness refrescado:${NC} $h"
                    ;;
            esac
        done
    fi

    echo -e "\n${GREEN}${BOLD}¡Actualización completa!${NC}"
    echo "PASS: update refreshed all detected harnesses"
}

# Run doctor diagnostics
cmd_doctor() {
    local json_mode=0
    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            json_mode=1
            break
        fi
    done

    local harnesses
    harnesses=$(detect_harnesses)

    local harness_exit=0
    local doctor_exit=0
    local has_fail=0
    local has_warn=0

    if [[ "$json_mode" -eq 1 ]]; then
        local harness_out="{}"
        local doctor_out="{}"
        if [[ -n "$harnesses" && -f "${REPO_ROOT}/scripts/specai-harness-doctor.sh" ]]; then
            harness_out=$(bash "${REPO_ROOT}/scripts/specai-harness-doctor.sh" --json 2>/dev/null) || harness_exit=$?
        fi
        if [ -f "${REPO_ROOT}/scripts/specai-doctor.sh" ]; then
            doctor_out=$(bash "${REPO_ROOT}/scripts/specai-doctor.sh" "$@" 2>/dev/null) || doctor_exit=$?
        fi

        if [[ "$harness_exit" -ge 2 || "$doctor_exit" -ge 2 ]]; then
            has_fail=1
        elif [[ "$harness_exit" -eq 1 || "$doctor_exit" -eq 1 ]]; then
            has_warn=1
        fi

        python3 - "${harnesses}" "${harness_out}" "${doctor_out}" "${has_fail}" "${has_warn}" <<'PY'
import json, sys
harnesses_str, harness_json, doctor_json, has_fail, has_warn = sys.argv[1:6]
try:
    harness_data = json.loads(harness_json)
except Exception:
    harness_data = {}
try:
    doctor_data = json.loads(doctor_json)
except Exception:
    doctor_data = {}

harnesses_list = harnesses_str.split() if harnesses_str else []

if has_fail == "1" or doctor_data.get("fail", 0) > 0 or harness_data.get("overall") == "FAIL":
    overall = "FAIL"
elif has_warn == "1" or doctor_data.get("warn", 0) > 0 or harness_data.get("overall") == "WARN":
    overall = "WARN"
else:
    overall = "OK"

payload = {
    "overall": overall,
    "detected_harnesses": harnesses_list,
    "harness_doctor": harness_data,
    "doctor": doctor_data
}
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY
        if [[ "$has_fail" -eq 1 ]]; then
            return 2
        fi
        return 0
    fi

    echo -e "${BLUE}${BOLD}═══════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}${BOLD}            SpecAI — Diagnóstico Unificado             ${NC}"
    echo -e "${BLUE}${BOLD}═══════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}Harnesses detectados:${NC} ${harnesses:-ninguno}"
    echo ""

    # 1. Native harness doctor (only if harnesses are detected)
    if [ -n "$harnesses" ] && [ -f "${REPO_ROOT}/scripts/specai-harness-doctor.sh" ]; then
        echo -e "${BLUE}${BOLD}[1/2] Diagnóstico de Harnesses y Subagentes...${NC}"
        bash "${REPO_ROOT}/scripts/specai-harness-doctor.sh" || harness_exit=$?
        echo ""
    else
        echo -e "${BLUE}${BOLD}[1/2] Diagnóstico de Harnesses y Subagentes...${NC}"
        echo -e "  ${YELLOW}ℹ No se detectaron harnesses activos para auditar.${NC}"
        echo ""
    fi

    # 2. General SpecAI doctor
    if [ -f "${REPO_ROOT}/scripts/specai-doctor.sh" ]; then
        echo -e "${BLUE}${BOLD}[2/2] Diagnóstico de Configuración y Skills...${NC}"
        bash "${REPO_ROOT}/scripts/specai-doctor.sh" "$@" || doctor_exit=$?
        echo ""
    fi

    # 3. Check extra detected harness link health (Hermes / Universal)
    if [[ " $harnesses " =~ " hermes " ]]; then
        local hermes_count=0
        if [ -d "${HERMES_SKILLS_DIR}" ]; then
            hermes_count=$(find "${HERMES_SKILLS_DIR}" -mindepth 1 -maxdepth 1 -name "specai-*" 2>/dev/null | wc -l || true)
        fi
        if [ "$hermes_count" -gt 0 ]; then
            echo -e "  ${GREEN}✓${NC} Hermes: ${hermes_count} skills vinculadas en ${HERMES_SKILLS_DIR}"
        else
            echo -e "  ${YELLOW}⚠️${NC}  Hermes: 0 skills vinculadas en ${HERMES_SKILLS_DIR} (ejecutá: ./specai link-hermes)"
        fi
    fi
    if [[ " $harnesses " =~ " universal " ]]; then
        local universal_count=0
        local u_dir="${UNIVERSAL_SKILLS_DIR:-${HOME}/.agents/skills}"
        if [ -d "${u_dir}" ]; then
            universal_count=$(find "${u_dir}" -mindepth 1 -maxdepth 1 -name "specai-*" 2>/dev/null | wc -l || true)
        fi
        if [ "$universal_count" -gt 0 ]; then
            echo -e "  ${GREEN}✓${NC} Universal (.agents): ${universal_count} skills vinculadas en ${u_dir}"
        else
            echo -e "  ${YELLOW}⚠️${NC}  Universal (.agents): 0 skills vinculadas en ${u_dir} (ejecutá: ./specai link-universal)"
        fi
    fi

    if [[ "$harness_exit" -ge 2 || "$doctor_exit" -ge 2 ]]; then
        has_fail=1
    elif [[ "$harness_exit" -eq 1 || "$doctor_exit" -eq 1 ]]; then
        has_warn=1
    fi

    echo ""
    echo -e "${CYAN}${BOLD}───────────────────────────────────────────────────────${NC}"
    echo -e "${CYAN}${BOLD}  Resumen Consolidado de Diagnóstico SpecAI${NC}"
    echo -e "${CYAN}${BOLD}───────────────────────────────────────────────────────${NC}"
    echo -e "  Harnesses evaluados: ${harnesses:-ninguno}"
    if [[ "$has_fail" -eq 1 ]]; then
        echo -e "  ${RED}✘ Estado global: FALLO (se detectaron errores críticos)${NC}"
        return 2
    elif [[ "$has_warn" -eq 1 ]]; then
        echo -e "  ${YELLOW}⚠ Estado global: ADVERTENCIAS (el entorno funciona pero tiene advertencias)${NC}"
        return 0
    else
        echo -e "  ${GREEN}✓ Estado global: SALUDABLE (todos los componentes OK)${NC}"
        return 0
    fi
}

