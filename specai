# Update: re-link plugin + re-inject agents (delegates to cmd_update)
update_all() {
    cmd_update "$@"
}

# Install specai skills into Hermes's $HERMES_HOME/skills/ as per-skill symlinks.
# One symlink per skill in skills/ — individually addressable by
# `hermes skills list/uninstall <name>` and easy to clean up.
#
# CAVEAT: uninstall-hermes() below removes any ~/.hermes/skills/specai-*
# symlink, including ones installed from the Hermes skill hub. The specai
# conventions keep skill names in the `specai-*` namespace, so this is
# expected behavior — if the user has specai skills from the hub, those
# will also be removed by uninstall-hermes. Reinstall them with
# `hermes skills install <id>` after.
install_hermes() {
    echo -e "${BLUE}Instalando skills de specai en Hermes...${NC}"

    if [ ! -d "${REPO_SKILLS_DIR}" ]; then
        echo -e "${RED}Error: el directorio de skills ${REPO_SKILLS_DIR} no existe.${NC}"
        exit 1
    fi

    mkdir -p "${HERMES_SKILLS_DIR}"

    local linked=0
    local skipped=0
    # Bash nullglob: a missing/empty glob yields no matches (so the loop
    # body doesn't run a single time with the literal pattern).
    shopt -s nullglob
    for skill_dir in "${REPO_SKILLS_DIR}"/*/; do
        local name
        name="$(basename "${skill_dir}")"
        # Only link skills that ship a SKILL.md (skip docs/, references/, etc.
        # that may also live under skills/ as supporting subdirs).
        if [ ! -f "${skill_dir}SKILL.md" ]; then
            continue
        fi
        local target="${HERMES_SKILLS_DIR}/${name}"
        # Replace existing symlink or directory so re-runs stay idempotent.
        if [ -L "${target}" ] || [ -e "${target}" ]; then
            rm -rf "${target}"
        fi
        ln -s "${skill_dir%/}" "${target}"
        linked=$((linked + 1))
    done
    shopt -u nullglob

    echo -e "${GREEN}✓ ${linked} skill(s) de specai vinculadas en ${HERMES_SKILLS_DIR}${NC}"
    if [ "${skipped}" -gt 0 ]; then
        echo -e "${YELLOW}  ${skipped} ya estaban instaladas (revisá con 'hermes skills list')${NC}"
    fi
    echo -e "\n${GREEN}${BOLD}Instalación en Hermes completada.${NC}"
    echo -e "Verificá con: ${CYAN}hermes skills list | grep specai${NC}\n"
}

# Remove specai skill symlinks from Hermes's skills directory.
uninstall_hermes() {
    echo -e "${BLUE}Desinstalando specai de Hermes...${NC}"

    if [ ! -d "${HERMES_SKILLS_DIR}" ]; then
        echo -e "${YELLOW}  El directorio ${HERMES_SKILLS_DIR} no existe — nada que desinstalar.${NC}"
        return 0
    fi

    local removed=0
    # glob with -- to keep `specai-*` from expanding to filenames starting with `-`.
    shopt -s nullglob
    for link in "${HERMES_SKILLS_DIR}"/specai-*; do
        if [ -L "${link}" ]; then
            rm -f "${link}"
            echo -e "  ${RED}✗${NC} Removido: $(basename "${link}")"
            removed=$((removed + 1))
        fi
    done
    shopt -u nullglob

    if [ "${removed}" -eq 0 ]; then
        echo -e "${YELLOW}  No había skills de specai instaladas en Hermes.${NC}"
    fi
    echo -e "\n${GREEN}${BOLD}Desinstalación de Hermes completada.${NC}\n"
}

# Link/unlink Antigravity
link_antigravity() {
    install_plugin "$@"
}

unlink_antigravity() {
